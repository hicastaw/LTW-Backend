# MongoDB Atlas connection string
# Thay <username>, <password>, <cluster> bằng thông tin MongoDB Atlas của bạn
DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/photosharing?retryWrites=true&w=majority

# JWT secret key - đặt chuỗi bí mật ngẫu nhiên, đủ dài
JWT_SECRET=your_jwt_secret_key_here
